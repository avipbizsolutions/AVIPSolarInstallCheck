<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Install" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorSecondary">@color/sun</item>
        <item name="colorOnSecondary">#10263A</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="Theme.Install.Splash">
        <item name="android:windowBackground">@color/brand</item>
        <item name="android:navigationBarColor">@color/brand</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <style name="Theme.Install.Camera">
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
